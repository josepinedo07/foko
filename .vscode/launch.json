{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir FieldLens en Navegador",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000/remote-expert.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Iniciar Servidor Python",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal"
    }
  ]
}
