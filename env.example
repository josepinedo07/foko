# FOKO — variables de entorno (Vercel > Project > Settings > Environment Variables).
# Copia las que apliquen. NUNCA subas valores reales al repo.

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor, jamás en el frontend

# --- Reporte con IA (Gemini / Google AI Studio) ---
GEMINI_API_KEY=
REPORT_MODEL=gemini-3.5-flash-lite   # opcional

# --- Crons (Vercel manda Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

# --- Facturación por pasarela ---
BILLING_PROVIDER=sim                 # sim | (dlocal | instapago | bancamiga cuando existan)
BILLING_WEBHOOK_SECRET=              # firma de los webhooks / tokens de checkout (cadena larga aleatoria)
PUBLIC_BASE_URL=https://fokoremote.com   # opcional; si falta se infiere del request

# Cuando se elija dLocal (ejemplo, aún no usado):
# DLOCAL_API_KEY=
# DLOCAL_SECRET_KEY=
# DLOCAL_WEBHOOK_SECRET=
