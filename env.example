# FOKO — variables de entorno (Vercel > Project > Settings > Environment Variables).
# Copia las que apliquen. NUNCA subas valores reales al repo.

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor, jamás en el frontend

# --- Reporte con IA (Gemini / Google AI Studio) ---
GEMINI_API_KEY=
REPORT_MODEL=gemini-3.5-flash-lite   # opcional

# --- Crons (Vercel manda Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

# --- Avisos de leads (api/lead.js, vía Resend) ---
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=           # a dónde te llega el aviso de cada lead nuevo
LEAD_CONFIRM_FROM=           # remitente del correo de confirmación al prospecto, ej.
                              # "FOKO <ventas@fokoremote.com>" — una vez verificado el
                              # dominio en Resend. Sin esto usa el remitente compartido.

# --- TURN propio (dashboard.metered.ca) — evita el relay público de pruebas ---
METERED_SECRET_KEY=     # "Developers" en el dashboard — NUNCA al frontend, solo server
METERED_SUBDOMAIN=      # el que asigna Metered, ej. "fokoremote" (fokoremote.metered.live)

# --- Facturación por pasarela ---
BILLING_SELFSERVE_ENABLED=           # vacío/"0" = apagado (alta manual por venta directa). "1" cuando haya pasarela real.
BILLING_PROVIDER=sim                 # sim | (dlocal | instapago | bancamiga cuando existan)
BILLING_WEBHOOK_SECRET=              # firma de los webhooks / tokens de checkout (cadena larga aleatoria)
PUBLIC_BASE_URL=https://fokoremote.com   # opcional; si falta se infiere del request

# Cuando se elija dLocal (ejemplo, aún no usado):
# DLOCAL_API_KEY=
# DLOCAL_SECRET_KEY=
# DLOCAL_WEBHOOK_SECRET=
