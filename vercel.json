{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/cleanup", "schedule": "0 4 * * *" },
    { "path": "/api/billing-cron", "schedule": "0 9 * * *" }
  ],
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
